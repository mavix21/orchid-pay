{
  "name": "@workspace/wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.server.ts",
    "./testnet": "./scripts/testnet-funding.ts",
    "./migrate": "./scripts/migrate.server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun ../../tools/wallet/check-boundary.mjs",
    "test:surfpool": "vitest run --config vitest.surfpool.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.server.ts",
    "testnet:verify": "bun scripts/testnet.server.ts",
    "testnet:link-claim": "bun scripts/testnet-link-claim-prefunded.server.ts",
    "channels:open": "bun scripts/open-channels.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "4.1.5",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@passwordless-id/webauthn": "2.4.1",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@stellar/stellar-sdk": "17.4.0",
    "@workspace/db": "workspace:*",
    "@workspace/orchid-links": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.5",
    "micro-key-producer": "0.10.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/bun": "1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
