{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["@effect/sql-pg/PgClient#layer"]
      }
    ]
  },
  "include": ["src"]
}
