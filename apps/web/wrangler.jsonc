{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchid-pay-devnet",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "072d5fa2baca4b1d81011fc7697da8f2",
      "localConnectionString": "postgres://orchid:orchid-local@127.0.0.1:55432/orchid",
    },
  ],
  "compatibility_date": "2026-11-15",
  "main": "src/server.ts",
  "vars": {
    "PASSKEY_ORIGINS": "http://localhost:3000,http://localhost:4173,https://orchid-pay-devnet.getorchid.workers.dev",
    "PAYOUT_PARTNER": "sandbox",
  },
  "secrets": {
    "required": [
      "SOLANA_RPC_URL",
      "SPONSOR_SECRET",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY",
      "SESSION_SECRET",
    ],
  },
  "ratelimits": [
    {
      "name": "WALLET_RATE_LIMITER",
      "namespace_id": "4801",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "4802",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "WALLET_WORK", "queue": "orchid-pay-devnet-work" },
    ],
    "consumers": [
      {
        "queue": "orchid-pay-devnet-work",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
}
